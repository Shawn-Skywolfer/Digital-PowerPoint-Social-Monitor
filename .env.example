# ===== 基本 =====
APP_ENV=dev
# 生产环境务必修改为一个长随机串（用于 JWT 签名与 Key 加密）
SECRET_KEY=please-change-me-to-a-long-random-string

# ===== 数据库 =====
# 默认 SQLite；云端多人可改 PostgreSQL/MySQL，例如：
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/monitor
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/monitor
DATABASE_URL=

# ===== 默认管理员（首次启动播种）=====
DEFAULT_ADMIN_USERNAME=Admin
DEFAULT_ADMIN_PASSWORD=Seek22626301
FORCE_CHANGE_DEFAULT_PASSWORD=true

# ===== CORS（前端地址，逗号分隔）=====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== dajiala =====
DAJIALA_BASE_URL=https://www.dajiala.com
# 无可用 Key / 本地调试时置 true，使用 Mock 数据源
PROVIDER_MOCK=true

# ===== 出站 HTTP 代理（内网/华为本机需要；云服务器直连则留空且 VERIFY_SSL=true）=====
# HTTP_PROXY=http://proxyjp.huawei.com:8080
# HTTP_VERIFY_SSL=false
HTTP_PROXY=
HTTP_VERIFY_SSL=true

# ===== 抓取/分析调参 =====
FETCH_CONCURRENCY=3
ANALYSIS_CONCURRENCY=3
LLM_REQUEST_TIMEOUT=120
